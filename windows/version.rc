#include <windows.h>
#include <version.h>

1 VERSIONINFO
 FILEVERSION PRODUCT_VERSION_NUMERIC
 PRODUCTVERSION PRODUCT_VERSION_NUMERIC
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0C0A04B0"
        BEGIN
            VALUE "FileDescription", "Pleiade WebGL Viewer\0"
            VALUE "FileVersion", PRODUCT_VERSION_STRING "\0"
            VALUE "InternalName", "Pleiade\0"
            VALUE "OriginalFilename", "Pleiade.exe\0"
            VALUE "ProductName", "Pleiade\0"
            VALUE "ProductVersion", PRODUCT_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0c0a, 1200
    END
END

1 RT_MANIFEST "viewer.manifest"
